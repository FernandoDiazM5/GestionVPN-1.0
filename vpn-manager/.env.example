# API same-origin por defecto. Solo definir si el backend vive en otro origen.
# VITE_API_URL=http://localhost:3001

# Piloto Firebase: mantener false hasta que backend, mapping y staging estén listos.
VITE_FEDERATED_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Debe coincidir con FIREBASE_TENANT_ID del backend cuando se use multi-tenancy.
# VITE_FIREBASE_TENANT_ID=
