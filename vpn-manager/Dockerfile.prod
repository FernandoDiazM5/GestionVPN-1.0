# ── Frontend MikroTik VPN Manager — Producción (monorepo + nginx) ───────────
#  Contexto de build = RAÍZ del monorepo.
#    docker build -f vpn-manager/Dockerfile.prod .

# Stage 1 — build del monorepo (contracts + Vite)
FROM node:22-alpine AS builder
ARG NPM_VERSION=12.0.1
RUN npm install --global "npm@${NPM_VERSION}" \
 && npm --version
WORKDIR /repo

COPY package*.json ./
COPY packages/ ./packages/
COPY vpn-manager/ ./vpn-manager/

RUN npm ci
RUN npm run build:contracts

# VITE_API_URL="" → el frontend usa URLs relativas y nginx proxea /api → backend
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
ARG VITE_FEDERATED_AUTH_ENABLED="false"
ARG VITE_FIREBASE_API_KEY=""
ARG VITE_FIREBASE_AUTH_DOMAIN=""
ARG VITE_FIREBASE_PROJECT_ID=""
ARG VITE_FIREBASE_APP_ID=""
ARG VITE_FIREBASE_TENANT_ID=""
ENV VITE_FEDERATED_AUTH_ENABLED=${VITE_FEDERATED_AUTH_ENABLED} \
    VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY} \
    VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN} \
    VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID} \
    VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID} \
    VITE_FIREBASE_TENANT_ID=${VITE_FIREBASE_TENANT_ID}
WORKDIR /repo/vpn-manager
RUN npm run build

# Stage 2 — servir con nginx (HTTPS + SSE)
FROM nginx:1.27-alpine
COPY --from=builder /repo/vpn-manager/dist /usr/share/nginx/html
COPY vpn-manager/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY vpn-manager/gestionvpn-security-headers.conf /etc/nginx/snippets/gestionvpn-security-headers.conf
EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
