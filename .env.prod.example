# ── Variables para docker-compose.prod.yml. Copiar a .env y rellenar. ───────
#    cp .env.prod.example .env   &&   chmod 600 .env
#  NO commitear .env.

# Contraseña root de MariaDB (solo para administración/backups)
DB_ROOT_PASSWORD=<root_segura_distinta>

# Contraseña del usuario de la app. DEBE coincidir con MYSQL_PASSWORD de server/.env.production
DB_APP_PASSWORD=<app_segura>

# Build del frontend. Mantener apagado hasta un canary aprobado.
# Estos identificadores web son publicos, pero deben corresponder a la app Firebase registrada.
VITE_FEDERATED_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_TENANT_ID=
