log_format navigation_perf 'ts=$time_iso8601 method=$request_method uri=$uri status=$status request_time=$request_time upstream_time=$upstream_response_time bytes=$bytes_sent';

upstream backend { server backend:3001; }

map $uri $auth_limit_key {
    default "";
    ~^/api/auth/(setup|login)$ $binary_remote_addr;
    ~^/api/auth/password-reset/(request|confirm)$ $binary_remote_addr;
    ~^/api/account/(login|register|verify|resend)$ $binary_remote_addr;
    ~^/api/team/accept$ $binary_remote_addr;
}
limit_req_zone $auth_limit_key zone=auth_coarse:10m rate=5r/s;

server {
    listen 80 default_server;
    server_name _;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://__JOINPOINT_FQDN__$request_uri; }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name __JOINPOINT_FQDN__;
    if ($host != __JOINPOINT_FQDN__) { return 444; }

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    access_log /var/log/nginx/access.log navigation_perf;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 10M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    location = / {
        add_header Cache-Control "no-cache, must-revalidate" always;
        include /etc/nginx/snippets/gestionvpn-security-headers.conf;
        try_files /index.html =404;
    }
    location ~* ^/(\.env|\.git|wp-admin|wp-login\.php|phpmyadmin|adminer|cgi-bin)(/|$) {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/ {
        limit_req zone=auth_coarse burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
    }
    location /metrics {
        proxy_pass http://backend/metrics;
        allow 127.0.0.1;
        deny all;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/gestionvpn-security-headers.conf;
        try_files $uri =404;
    }
    include /etc/nginx/snippets/gestionvpn-security-headers.conf;
}
