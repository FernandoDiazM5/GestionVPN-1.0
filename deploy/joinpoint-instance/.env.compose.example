# Esta plantilla no contiene valores funcionales ni secretos.
JOINPOINT_SOURCE_DIR=/opt/joinpoint/source
JOINPOINT_SERVER_ENV_FILE=/opt/joinpoint/config/server.env
JOINPOINT_TLS_DIR=/opt/joinpoint/tls
JOINPOINT_NGINX_CONFIG=/opt/joinpoint/config/nginx.conf
JOINPOINT_ACME_CHALLENGE_DIR=/opt/joinpoint/acme-challenge
JOINPOINT_INSTANCE_PRIVATE_KEY_FILE=/opt/joinpoint/secrets/instance-private.pem
JOINPOINT_AGENT_STATE_DIR=/opt/joinpoint/agent-state
JOINPOINT_INSTANCE_ID=<UUID_DE_ACTIVACION>
JOINPOINT_CENTRAL_URL=https://control.joinpoint.cloud
JOINPOINT_SOFTWARE_VERSION=<VERSION_INMUTABLE>
JOINPOINT_BACKEND_IMAGE=ghcr.io/fernandodiazm5/joinpoint-backend:<VERSION_INMUTABLE>
JOINPOINT_FRONTEND_IMAGE=ghcr.io/fernandodiazm5/joinpoint-frontend:<VERSION_INMUTABLE>
JOINPOINT_AGENT_IMAGE=ghcr.io/fernandodiazm5/joinpoint-agent:<VERSION_INMUTABLE>
DB_HOST_PORT=3307
DB_ROOT_PASSWORD=<GENERADO_LOCALMENTE>
DB_APP_PASSWORD=<GENERADO_LOCALMENTE>
WG0_INTENT_DIR=/opt/wg0-autosync
VITE_FEDERATED_AUTH_ENABLED=false
