FROM node:22-bookworm-slim AS dependencies
WORKDIR /opt/joinpoint/source
COPY package.json package-lock.json ./
COPY packages/joinpoint-protocol/package.json packages/joinpoint-protocol/package.json
COPY packages/joinpoint-instance-agent/package.json packages/joinpoint-instance-agent/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace=@joinpoint/instance-agent --include-workspace-root=false

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /opt/joinpoint/source
COPY --from=dependencies /opt/joinpoint/source/node_modules ./node_modules
COPY packages/joinpoint-protocol ./packages/joinpoint-protocol
COPY packages/joinpoint-instance-agent ./packages/joinpoint-instance-agent
RUN mkdir -p /var/lib/joinpoint-agent && chown -R node:node /var/lib/joinpoint-agent
USER node
ENTRYPOINT ["node", "packages/joinpoint-instance-agent/src/runner.js"]
