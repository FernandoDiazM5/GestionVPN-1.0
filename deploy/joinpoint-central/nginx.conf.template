limit_req_zone $binary_remote_addr zone=central_login:10m rate=5r/m;
server {
  listen 80;
  server_name __CENTRAL_FQDN__;
  location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://__CENTRAL_FQDN__$request_uri; }
}
server {
  listen 443 ssl;
  server_name __CENTRAL_FQDN__;
  if ($host != __CENTRAL_FQDN__) { return 444; }
  ssl_certificate /etc/nginx/ssl/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  location = /api/admin-auth/login { limit_req zone=central_login burst=3 nodelay; proxy_pass http://central:3100; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https; }
  location / { proxy_pass http://central:3100; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https; }
}
