# ── Servidor ──
PORT=3001
NODE_ENV=development
DATA_DIR=.

# ── MySQL (XAMPP) — Fase 1 multi-usuario / RBAC ──
# Por defecto XAMPP usa root sin contraseña en 127.0.0.1:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=vpn_manager
MYSQL_POOL=10

# Lease de túnel por inactividad (desarrollo)
TUNNEL_LEASE_TTL_MS=300000
EXPIRATION_JOB_INTERVAL_MS=30000

# ── CORS (orígenes permitidos, separados por coma) ──
# CORS_ORIGINS=http://localhost:5173

# ── Sesión JWT (Fase 2) ──
JWT_EXPIRES=8h
# Keyring opcional para rotacion sin corte. Si se omite, desarrollo usa
# DATA_DIR/.jwt_secret como clave activa legacy. Nunca versionar estos valores.
# JWT_ACTIVE_KID=2026-07
# JWT_ACTIVE_SECRET=
# JWT_PREVIOUS_KID=2026-06
# JWT_PREVIOUS_SECRET=

# ── Rate limiting anti fuerza bruta (Fase 2) ──
RL_MAX_FAILS=5
RL_WINDOW_MS=900000
# Secreto estable de 32+ bytes para seudonimizar IPs e identidades en buckets.
# Generar, por ejemplo: openssl rand -hex 32
AUTH_RATE_HMAC_KEY=

# ── Password hashing Argon2id (calibrar con security:hash-benchmark en el VPS) ──
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# -- Piloto Firebase Auth (apagado por defecto) --
# Firebase verifica identidad; usuarios, roles y workspaces siguen en MySQL.
FEDERATED_AUTH_ENABLED=false
FEDERATED_AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
# Opcional, solo si el proyecto usa Identity Platform multi-tenancy.
# FIREBASE_TENANT_ID=
FEDERATED_AUTH_MAX_AGE_SECONDS=300
# Etiqueta operativa usada por el preflight; no habilita la feature.
FIREBASE_PILOT_ENV=disabled
# ADC: en local puede apuntar a una configuracion fuera del repo.
# En produccion preferir Workload Identity Federation a claves JSON persistentes.
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/fuera-del-repo/google-adc.json

# ── URL pública del frontend (usada en los links de invitación) ──
# Ajusta al dominio real en producción (ej: https://vpn.tuempresa.com/GestionVPN-1.0/)
APP_BASE_URL=http://localhost:5173/GestionVPN-1.0/

# ── IP pública FIJA del MikroTik (Endpoint de WireGuard) ──
# Sobrescribe lo que reporta /ip/cloud/print del router. Útil cuando:
#  • El router está detrás de NAT
#  • Tienes IP pública estática y no quieres depender de cloud
#  • El cloud reporta una IP distinta a la que se debe usar
# Si la dejas vacía, el server hace auto-discover desde el router.
# WG_PUBLIC_IP=213.173.36.232

# ── SMTP para OTP e invitaciones — OPCIONAL ──
# Sin SMTP configurado, el OTP/invitación se imprime en consola (modo dev).
#
# ▼ GMAIL: cómo obtener el App Password (NO es tu contraseña normal):
#   1. Ve a https://myaccount.google.com/security
#   2. Activa "Verificación en 2 pasos" (obligatorio)
#   3. Ve a https://myaccount.google.com/apppasswords
#   4. Crea una contraseña de aplicación llamada "VPN Manager"
#   5. Pega los 16 caracteres en SMTP_PASS (sin espacios)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM=MikroTik VPN <tucorreo@gmail.com>
# Fallback para reportes. El valor guardado por el Administrador en Ajustes tiene prioridad.
# ERROR_REPORT_EMAIL=administrador@tuempresa.com  # fallback final: SMTP_USER
# Respaldo dual del MikroTik Core. La programación y contraseña se administran
# desde Ajustes; estas variables sólo acotan la extracción SFTP temporal.
CORE_BACKUP_SSH_SOURCE_CIDR=10.12.250.60/32
CORE_BACKUP_MAX_BYTES=15728640

# ── Gemini AirOS (apagado por defecto) ──
# La clave nunca se expone al frontend. Genera AI_PSEUDONYM_KEY con 32+ bytes aleatorios.
GEMINI_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PSEUDONYM_KEY=
GEMINI_DAILY_REQUEST_BUDGET=20
GEMINI_WORKSPACE_DAILY_REQUEST_BUDGET=10
GEMINI_DAILY_TOKEN_BUDGET=150000
GEMINI_USER_COOLDOWN_SECONDS=60
GEMINI_MAX_DEVICES_PER_NETWORK=40
GEMINI_MAX_INPUT_BYTES=60000
GEMINI_MAX_OUTPUT_TOKENS_DEVICE=700
GEMINI_MAX_OUTPUT_TOKENS_NETWORK=1200
GEMINI_TIMEOUT_MS=30000
GEMINI_DEVICE_CACHE_TTL_MS=300000
GEMINI_NETWORK_CACHE_TTL_MS=600000
GEMINI_ANALYSIS_RETENTION_DAYS=7
GEMINI_SNAPSHOT_RETENTION_DAYS=7
