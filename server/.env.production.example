# ── Plantilla de producción. Copiar a server/.env.production y rellenar. ────
#    cp server/.env.production.example server/.env.production
#  NO commitear server/.env.production (lleva secretos reales).

# ── Servidor ──
PORT=3001
NODE_ENV=production
# -- Sesion JWT y rotacion --
JWT_EXPIRES=8h
# Primera activacion de Fase 5: puede conservarse /data/.jwt_secret y kid=legacy.
# Para una rotacion posterior, configurar los cuatro valores active/previous
# durante al menos JWT_EXPIRES. Generar cada secreto fuera del repo:
#   openssl rand -hex 64
# JWT_ACTIVE_KID=2026-07
# JWT_ACTIVE_SECRET=<SECRETO_NUEVO_128_HEX>
# JWT_PREVIOUS_KID=legacy
# JWT_PREVIOUS_SECRET=<CONTENIDO_ANTERIOR_DE_.jwt_secret>
DATA_DIR=/data                 # aquí viven .db_secret y .jwt_secret (volumen backend-data)

# ── MySQL/MariaDB ── (backend host-mode → MariaDB publicada en 127.0.0.1:3307)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=vpn_app
MYSQL_PASSWORD=<IGUAL_QUE_DB_APP_PASSWORD_DEL_.env_RAIZ>
MYSQL_DATABASE=vpn_manager
MYSQL_POOL=10

# ── CORS ── (origen real del panel; despliegue IP+HTTPS autofirmado)
CORS_ORIGINS=https://joinpoint.cloud,https://www.joinpoint.cloud

# ── URL pública del frontend (para emails/invitaciones) ──
APP_BASE_URL=https://joinpoint.cloud/

# ── IP pública FIJA del MikroTik (para los .conf WireGuard de los usuarios) ──
#    Es la IP pública del ROUTER (no la del VPS, que es 134.199.212.232).
WG_PUBLIC_IP=213.173.36.232

# ── Jobs de fondo ──
EXPIRATION_JOB_ENABLED=true
# Lease renovado por el navegador cada minuto. Tras 5 min sin heartbeat,
# el job revoca la mangle en MikroTik y luego cierra MySQL.
TUNNEL_LEASE_TTL_MS=300000
EXPIRATION_JOB_INTERVAL_MS=30000
MONITORING_ENABLED=true
AP_POLL_ENABLED=true

# ── Rate limit de login ──
RL_MAX_FAILS=5
RL_WINDOW_MS=900000
AUTH_RATE_HMAC_KEY=<GENERAR_CON_OPENSSL_RAND_HEX_32>
SECURITY_AGENT_URL=http://127.0.0.1:8788
SECURITY_AGENT_SECRET=<MISMO_SECRETO_DE_64_HEX_QUE_EL_AGENTE>
SECURITY_AGENT_TIMEOUT_MS=5000
# Estado seguro previo al canary de protección web.
WEB_SECURITY_MODE=observe
WEB_SECURITY_ENFORCEMENT_CONFIRM=
WEB_SECURITY_INDEFINITE_CONFIRM=
WEB_SECURITY_ROLLOUT_PERCENT=0
WEB_SECURITY_ENFORCEMENT_INTERVAL_MS=60000
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# -- Piloto Firebase Auth (mantener false hasta completar el canary) --
FEDERATED_AUTH_ENABLED=false
FEDERATED_AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
# FIREBASE_TENANT_ID=
FEDERATED_AUTH_MAX_AGE_SECONDS=300
# Cambiar a staging solo en el entorno aislado del canary; no habilita la feature.
FIREBASE_PILOT_ENV=disabled
# ADC puede leer una configuracion WIF montada read-only. No copiar claves JSON al repo/imagen.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-application-credentials.json

# ── Métricas Prometheus solo locales ──
METRICS_ALLOW_REMOTE=0

# ── Plano de gestión (WireGuard) — segmentos 10.x ───────────────────────────
#   Fuente de verdad: server/lib/mgmtNet.js. Estos env solo hacen falta si
#   quieres SOBREESCRIBIR los defaults; coinciden con mgmtNet.js.
#     VPS      VPN-WG-VPS       10.12.250.0/24  :13232  (.60)
#     CLIENTES VPN-WG-CLIENTES  10.13.250.0/24  :13233  (moderadores/members)
#     ADMIN    VPN-WG-ADMIN     10.14.250.0/24  :13234  (admin)
#   IP ÚNICA POR NODO (transporte + gestión unificados; la .1 = Core, ND≥2):
#     nodos WG → 10.11.250.<ND> · nodos SSTP → 10.11.251.<ND> (= remote-address)
#   Las viejas redes de transporte (10.10.250 SSTP / 10.10.251 WG /30) quedaron
#   obsoletas. En el router: PROF-VPN-TOWERS local-address=10.11.251.1.
# MGMT_VPS_IFACE=VPN-WG-VPS
# MGMT_VPS_IP=10.12.250.60
# MGMT_CLIENTS_IFACE=VPN-WG-CLIENTES
# MGMT_ADMIN_IFACE=VPN-WG-ADMIN
# MGMT_NODE_SSTP_LOCAL=10.11.251.1

# ── Opción C: pool de scan-IPs del VPS (escaneo + Monitor AP multi-VRF) ──
#   El pool vive en 10.11.252.0/24: un /24 DEDICADO, separado de la gestión
#   por nodo (10.11.250/251) y de cualquier LAN de torre.
#   Requiere: pool en wg0 del VPS + allowed-address del peer VPS en MikroTik +
#   ruta de retorno por VRF (SCAN_RETURN_SUBNET, abajo) vía VPN-WG-VPS.
SCAN_IP_POOL_BASE=10.11.252.
SCAN_IP_POOL_START=2
SCAN_IP_POOL_END=254
# /24 de scan-IP para el que provision.routes añade ruta de retorno en cada VRF.
SCAN_RETURN_SUBNET=10.11.252.0/24

# ── SMTP (Gmail App Password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fernandodiazm.5@gmail.com
SMTP_PASS=<APP_PASSWORD_16_CHARS>
SMTP_FROM=MikroTik VPN <fernandodiazm.5@gmail.com>
# Destinatario fijo de errores inesperados del frontend (usa el SMTP anterior).
# Fallback: el destinatario configurado desde Ajustes tiene prioridad.
ERROR_REPORT_EMAIL=administrador@tuempresa.com  # si se omite, usa SMTP_USER

# ── Telegram ──
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=<TOKEN_DEL_BOT>
CORE_BACKUP_SSH_SOURCE_CIDR=10.12.250.60/32
CORE_BACKUP_MAX_BYTES=15728640

# ── Gemini AirOS (activar sólo después de migrar y probar con un moderador piloto) ──
GEMINI_AI_ENABLED=false
GEMINI_API_KEY=<API_KEY_FREE_TIER_DE_GOOGLE_AI_STUDIO>
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PSEUDONYM_KEY=<SECRETO_ALEATORIO_DE_32_BYTES_O_MAS>
GEMINI_DAILY_REQUEST_BUDGET=20
GEMINI_WORKSPACE_DAILY_REQUEST_BUDGET=10
GEMINI_DAILY_TOKEN_BUDGET=150000
GEMINI_USER_COOLDOWN_SECONDS=60
GEMINI_MAX_DEVICES_PER_NETWORK=40
GEMINI_MAX_INPUT_BYTES=60000
GEMINI_MAX_OUTPUT_TOKENS_DEVICE=700
GEMINI_MAX_OUTPUT_TOKENS_NETWORK=1200
GEMINI_TIMEOUT_MS=30000
GEMINI_DEVICE_CACHE_TTL_MS=300000
GEMINI_NETWORK_CACHE_TTL_MS=600000
GEMINI_ANALYSIS_RETENTION_DAYS=7
GEMINI_SNAPSHOT_RETENTION_DAYS=7
