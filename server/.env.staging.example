# Backend aislado para el canary de Firebase. Copiar a server/.env.staging.
# No reutilizar secretos, base de datos ni credenciales de producción.

PORT=3001
NODE_ENV=production
DATA_DIR=/data
JWT_EXPIRES=8h
JWT_ACTIVE_KID=staging-2026
JWT_ACTIVE_SECRET=<GENERAR_128_HEX>

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=vpn_staging
MYSQL_PASSWORD=<IGUAL_QUE_STAGING_DB_APP_PASSWORD>
MYSQL_DATABASE=vpn_manager_staging
MYSQL_POOL=5

# Sustituir por el origen HTTPS real de staging, incluido el puerto si aplica.
CORS_ORIGINS=https://staging.example.com
APP_BASE_URL=https://staging.example.com/GestionVPN-1.0/

EXPIRATION_JOB_ENABLED=true
MONITORING_ENABLED=false
AP_POLL_ENABLED=false
TELEGRAM_BOT_ENABLED=false
GEMINI_AI_ENABLED=false
WG0_AUTOSYNC=false
METRICS_ALLOW_REMOTE=0

RL_MAX_FAILS=5
RL_WINDOW_MS=900000
AUTH_RATE_HMAC_KEY=<GENERAR_64_HEX>
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

FIREBASE_PILOT_ENV=staging
FEDERATED_AUTH_ENABLED=true
FEDERATED_AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=<PROYECTO_FIREBASE_STAGING>
FEDERATED_AUTH_MAX_AGE_SECONDS=300
# FIREBASE_TENANT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-application-credentials.json

# El canary no debe operar MikroTik, SMTP, Telegram ni Gemini.
MT_IP=127.0.0.1
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
