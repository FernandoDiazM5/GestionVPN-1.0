# Variables de Docker Compose para el stack Firebase de staging.
# Copiar a .env.staging y mantener fuera de Git.

STAGING_DB_ROOT_PASSWORD=<GENERAR_SECRETO_DISTINTO>
STAGING_DB_APP_PASSWORD=<GENERAR_SECRETO_DISTINTO>

# Puerto HTTPS público del canary. Producción conserva 80/443.
STAGING_HTTP_PORT=8081
STAGING_HTTPS_PORT=8444

# Firebase Web: identificadores públicos de la app exclusiva de staging.
# Mantener false hasta que firebase:preflight -- --provider indique LISTO.
VITE_FEDERATED_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_TENANT_ID=

# Ruta absoluta en el host a ADC/WIF. Nunca ubicarla dentro del repositorio.
STAGING_GOOGLE_APPLICATION_CREDENTIALS=
