{
  "name": "mikrotik-vpn-manager",
  "version": "1.0.0",
  "packageManager": "npm@12.0.1",
  "private": true,
  "description": "Panel SaaS multi-tenant para gestión de túneles VPN sobre MikroTik (SSTP + WireGuard) y monitoreo de equipos Ubiquiti airOS.",
  "repository": {
    "type": "git",
    "url": "https://github.com/FernandoDiazM5/GestionVPN-1.0"
  },
  "license": "UNLICENSED",
  "workspaces": [
    "control-plane",
    "packages/*",
    "server",
    "vpn-manager"
  ],
  "scripts": {
    "prepare": "husky || true",
    "build:contracts": "npm run build --workspace=@gestionvpn/contracts",
    "check:protocol": "npm run check --workspace=@joinpoint/protocol",
    "check:control-plane": "npm run check --workspace=@joinpoint/control-plane",
    "test:control-plane": "npm test --workspace=@joinpoint/control-plane",
    "check:instance-agent": "npm run check --workspace=@joinpoint/instance-agent",
    "test:instance-agent": "npm test --workspace=@joinpoint/instance-agent",
    "check:backend": "cd server && node --check index.js && node -e \"['./auth.routes.js','./routes/account.routes.js','./routes/federatedAuth.routes.js','./routes/admin.routes.js','./routes/team.routes.js','./routes/workspace.routes.js','./routes/errorReports.routes.js','./routes/ai.routes.js','./routes/core/index.js','./routes/core/_shared.js','./routes/core/connection.routes.js','./routes/core/tunnel.routes.js','./routes/core/tunnel-repair.routes.js','./routes/nodes/index.js','./routes/nodes/_shared.js','./routes/nodes/listing.routes.js','./routes/nodes/provision.routes.js','./routes/nodes/editing.routes.js','./routes/nodes/tags.routes.js','./routes/nodes/credentials.routes.js','./routes/nodes/history.routes.js','./routes/nodes/scan.routes.js','./routes/wireguard.routes.js','./routes/settings.routes.js','./routes/device.routes.js','./routes/events.routes.js','./routes/audit.routes.js','./routes/health.routes.js'].forEach(f=>require('child_process').execSync('node --check '+f,{stdio:'inherit'}));\"",
    "check:frontend": "cd vpn-manager && npx tsc --noEmit",
    "check:security-routes": "npm run security:routes:check --prefix server",
    "lint:frontend": "cd vpn-manager && npm run lint",
    "check:all": "npm run check:backend && npm run check:security-routes && npm run check:frontend && npm run lint:frontend",
    "test:backend": "npm test --prefix server",
    "test:frontend": "npm test --prefix vpn-manager",
    "test:all": "npm run test:backend && npm run test:frontend",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "audit:design": "node scripts/audit-design.js",
    "audit:design:json": "node scripts/audit-design.js --json",
    "audit:semgrep": "node scripts/semgrep.js",
    "audit:semgrep:json": "node scripts/semgrep.js --json",
    "audit:semgrep:javascript": "node scripts/semgrep.js --profile=javascript server",
    "audit:semgrep:typescript": "node scripts/semgrep.js --profile=typescript vpn-manager/src packages/contracts/src",
    "audit:semgrep:react": "node scripts/semgrep.js --profile=react vpn-manager/src",
    "audit:semgrep:secrets": "node scripts/semgrep.js --profile=secrets server vpn-manager/src packages/contracts/src",
    "audit:semgrep:security": "node scripts/semgrep.js --profile=security server vpn-manager/src packages/contracts/src",
    "test:semgrep-rules": "node scripts/test-semgrep-rules.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "^3.4.12",
    "form-data": "^4.0.6",
    "uuid": "11.1.1"
  },
  "lint-staged": {
    "vpn-manager/src/**/*.{ts,tsx}": [
      "npx eslint --config vpn-manager/eslint.config.js --fix"
    ],
    "server/**/*.js": [
      "node --check"
    ]
  },
  "allowScripts": {
    "argon2@0.45.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true,
    "protobufjs@7.6.5": true,
    "@firebase/util@1.15.1": true,
    "@google/genai@2.12.0": false,
    "core-js@3.49.0": false,
    "msw@2.14.6": false
  }
}
