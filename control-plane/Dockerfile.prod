FROM node:22-bookworm-slim AS web-build
WORKDIR /app
COPY package.json package-lock.json ./
COPY central-manager/package.json central-manager/package.json
RUN npm ci --ignore-scripts --workspace=@joinpoint/central-manager --include-workspace-root=false
COPY central-manager central-manager
RUN npm run build --workspace=@joinpoint/central-manager

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/joinpoint-protocol/package.json packages/joinpoint-protocol/package.json
COPY control-plane/package.json control-plane/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace=@joinpoint/control-plane --include-workspace-root=false \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY packages/joinpoint-protocol packages/joinpoint-protocol
COPY control-plane control-plane
COPY --from=web-build /app/central-manager/dist central-manager/dist
RUN chown -R node:node /app
USER node
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3100/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["sh", "control-plane/entrypoint.sh"]
